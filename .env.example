# These values are intentionally exposed to the browser. Use only the project URL
# and the Supabase publishable key (never a service_role or secret key).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Optional function-name overrides. The defaults are shown here for clarity.
VITE_SUPABASE_SUBMIT_FUNCTION=submit-application
VITE_SUPABASE_DOCUMENTS_FUNCTION=admin-application-document
